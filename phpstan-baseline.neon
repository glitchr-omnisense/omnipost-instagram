parameters:
	ignoreErrors:
		-
			message: '#^Cannot cast mixed to int\.$#'
			identifier: cast.int
			count: 2
			path: Api.php

		-
			message: '#^Cannot cast mixed to string\.$#'
			identifier: cast.string
			count: 1
			path: Api.php

		-
			message: '#^Method Omnipost\\Instagram\\Api\:\:call\(\) should return array\<string, mixed\> but returns array\<mixed\>\.$#'
			identifier: return.type
			count: 1
			path: Api.php

		-
			message: '#^Parameter \#2 \$data of method Omnipost\\Instagram\\Api\:\:error\(\) expects array\<string, mixed\>, array\<mixed\> given\.$#'
			identifier: argument.type
			count: 1
			path: Api.php

		-
			message: '#^Cannot access offset 0 on mixed\.$#'
			identifier: offsetAccess.nonOffsetAccessible
			count: 1
			path: InstagramProvider.php

		-
			message: '#^Cannot cast mixed to int\.$#'
			identifier: cast.int
			count: 5
			path: InstagramProvider.php

		-
			message: '#^Cannot cast mixed to string\.$#'
			identifier: cast.string
			count: 8
			path: InstagramProvider.php

		-
			message: '#^Parameter \#1 \$fields of method Omnipost\\Instagram\\InstagramProvider\:\:container\(\) expects array\<string, bool\|float\|int\|string\|null\>, array\<string, mixed\> given\.$#'
			identifier: argument.type
			count: 1
			path: InstagramProvider.php

		-
			message: '#^Parameter \#2 \$scopes of method Omnipost\\Instagram\\InstagramProvider\:\:hold\(\) expects list\<string\>, list\<mixed\> given\.$#'
			identifier: argument.type
			count: 1
			path: InstagramProvider.php

		-
			message: '#^Cannot cast mixed to string\.$#'
			identifier: cast.string
			count: 6
			path: InstagramProviderFactory.php

		-
			message: '#^Call to an undefined method Omnipost\\ProviderInterface\:\:account\(\)\.$#'
			identifier: method.notFound
			count: 2
			path: Tests/InstagramProviderTest.php

		-
			message: '#^Call to an undefined method Omnipost\\ProviderInterface\:\:capabilities\(\)\.$#'
			identifier: method.notFound
			count: 1
			path: Tests/InstagramProviderTest.php

		-
			message: '#^Call to an undefined method Omnipost\\ProviderInterface\:\:feed\(\)\.$#'
			identifier: method.notFound
			count: 1
			path: Tests/InstagramProviderTest.php

		-
			message: '#^Cannot access property \$accessToken on Omnipost\\Model\\Token\|null\.$#'
			identifier: property.nonObject
			count: 1
			path: Tests/InstagramProviderTest.php

		-
			message: '#^Cannot access property \$mediaMaxCount on mixed\.$#'
			identifier: property.nonObject
			count: 1
			path: Tests/InstagramProviderTest.php

		-
			message: '#^Method Omnipost\\Instagram\\Tests\\InstagramProviderTest\:\:feedPage\(\) return type has no value type specified in iterable type array\.$#'
			identifier: missingType.iterableValue
			count: 1
			path: Tests/InstagramProviderTest.php

		-
			message: '#^Method Omnipost\\Instagram\\Tests\\InstagramProviderTest\:\:json\(\) has parameter \$data with no value type specified in iterable type array\.$#'
			identifier: missingType.iterableValue
			count: 1
			path: Tests/InstagramProviderTest.php

		-
			message: '#^Method Omnipost\\Instagram\\Tests\\InstagramProviderTest\:\:provider\(\) has parameter \$options with no value type specified in iterable type array\.$#'
			identifier: missingType.iterableValue
			count: 1
			path: Tests/InstagramProviderTest.php

		-
			message: '#^Method Omnipost\\Instagram\\Tests\\InstagramProviderTest\:\:provider\(\) should return Omnipost\\Instagram\\InstagramProvider but returns Omnipost\\ProviderInterface\.$#'
			identifier: return.type
			count: 1
			path: Tests/InstagramProviderTest.php

		-
			message: '#^Parameter \#1 \$options of method Omnipost\\ProviderFactory\:\:create\(\) expects array\<string, mixed\>, array given\.$#'
			identifier: argument.type
			count: 1
			path: Tests/InstagramProviderTest.php

		-
			message: '#^Property Omnipost\\Instagram\\Tests\\InstagramProviderTest\:\:\$calls \(list\<array\{string, string, array\<string, string\>\}\>\) does not accept non\-empty\-list\<array\{string, string, array\<int\|string, array\<mixed\>\|string\>\}\>\.$#'
			identifier: assign.propertyType
			count: 1
			path: Tests/InstagramProviderTest.php

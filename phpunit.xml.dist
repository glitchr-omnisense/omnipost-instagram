<?xml version="1.0" encoding="UTF-8"?>
<!-- This package's tests alone, as glitchr-studio/ci's php-package.yml runs them (vendor/bin/phpunit). -->
<phpunit xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:noNamespaceSchemaLocation="vendor/phpunit/phpunit/phpunit.xsd"
         bootstrap="vendor/autoload.php" colors="true" cacheDirectory=".phpunit.cache"
         failOnWarning="true">
    <testsuites>
        <testsuite name="unit"><directory>Tests</directory></testsuite>
    </testsuites>
</phpunit>
